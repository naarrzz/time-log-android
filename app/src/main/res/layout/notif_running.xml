<?xml version="1.0" encoding="utf-8"?>
<!-- The running tile on the system's own notification surface: a thin bar in the tile's color,
     the name and sub on the left, and a large ticking timer on the right. Text colors come from the
     system notification styles, so it reads in light, dark and on the lock screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/notif_accent"
        android:layout_width="4dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/accent_bar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/notif_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:textSize="13sp" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/notif_chrono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:textSize="26sp" />
</LinearLayout>
